[Unit]
Description=Mailbridge secure mail gateway
Documentation=https://github.com/imrasalghul/mailbridge/wiki
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/mailbridge/mailbridge.env

[Service]
Type=simple
User=mailbridge
Group=mailbridge
Environment=NODE_ENV=production
EnvironmentFile=/etc/mailbridge/mailbridge.env
ExecStart=/usr/bin/mailbridge
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mailbridge
ReadOnlyPaths=/etc/mailbridge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
