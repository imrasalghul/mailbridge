# Node App Configuration
# Fresh-install defaults. Existing .env files without this setting remain legacy.
# Legacy preserves working plugin/configuration interfaces, not old dependencies or bugs.
MAILBRIDGE_BEHAVIOR_PROFILE=modern
# Optional per-feature overrides; unset values follow the profile.
# MAILBRIDGE_PLUGIN_STRICT=true
# MAILBRIDGE_DELIVERY_RECEIPTS=true
# MAILBRIDGE_HTTP_ALLOW_REDIRECTS=false
# MAILBRIDGE_HTTP_TIMEOUT_MS=120000
# MAILBRIDGE_LOG_FORMAT=json
# MAILBRIDGE_STRICT_FILE_READS=true
# MAILBRIDGE_DEAD_LETTER_QUEUE=true
PORT=3090
SMTP_RELAY_PORT=2525
SMTP_RELAY_SOCKET_TIMEOUT_MS=120000
SMTP_RELAY_MAX_MESSAGE_BYTES=52428800
MAILBRIDGE_VERBOSE_LOGGING=true
MAILBRIDGE_HOSTNAME=mailbridge.example.com
QUEUE_MAX_ATTEMPTS=20
DATA_DIR=/app/data
SECRETS_DB_PATH=/app/secrets/secrets.db
MAILBRIDGE_PLUGIN_DIR=/app/data/plugins
MAILBRIDGE_PLUGIN_LOCKFILE=/app/data/plugins.lock.json
MAILBRIDGE_PLUGIN_CONFIG_FILE=/app/data/plugins.config.json
QUEUE_MASTER_KEY=
MAILBRIDGE_PRIVATE_KEY_PATH=/app/secrets/mailbridge-r2-private.pem
AUDIT_LOG_RETENTION_DAYS=1

# Optional in-container Cloudflare Tunnel
# Set CLOUDFLARED_ENABLED=true only if this container should run cloudflared itself.
# Use the tunnel token from Cloudflare Dashboard > Networking > Tunnels.
CLOUDFLARED_ENABLED=false
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_LOGLEVEL=info

# Security - Make sure this matches the WEBHOOK_SECRET in your Cloudflare Worker variables
WEBHOOK_SECRET=replace_with_a_shared_secret

# Local Mail Server Configuration (inbound destination)
LOCAL_MAIL_HOST=mail.internal.example
LOCAL_MAIL_PORT=25
LOCAL_MAIL_SECURE=false
LOCAL_MAIL_REQUIRE_TLS=true
LOCAL_MAIL_TLS_REJECT_UNAUTHORIZED=true
LOCAL_MAIL_TLS_SERVERNAME=
LOCAL_MAIL_TLS_CA_FILE=

# Outbound Relay Provider Configuration (local SMTP relay -> Internet)
RELAY_UPSTREAM_PROVIDER=cloudflare
RELAY_FROM_FALLBACK=relay@example.com
CLOUDFLARE_SEND_WORKER_URL=
CLOUDFLARE_SEND_WEBHOOK_SECRET=
SMTP_RELAY_ENABLED=false
SMTP_RELAY_VERBOSE_LOGGING=true
SMTP_RELAY_INJECT_HEADERS=true
SMTP_RELAY_REQUIRE_TLS=true
SMTP_RELAY_ALLOW_INSECURE=false
SMTP_RELAY_ALLOWED_CIDRS=127.0.0.1/32,::1/128
SMTP_RELAY_TLS_CERT_FILE=
SMTP_RELAY_TLS_KEY_FILE=
SMTP_RELAY_TLS_CA_FILE=

# SpamAssassin Config
# SPAMASSASSIN_MODE=local starts in-container spamd.
# SPAMASSASSIN_MODE=postmark uses https://spamcheck.postmarkapp.com/filter and skips local spamd.
SPAMASSASSIN_MODE=local
POSTMARK_SPAMCHECK_URL=https://spamcheck.postmarkapp.com/filter
SPAMD_HOST=127.0.0.1
SPAMD_PORT=783
SPAMD_STARTUP_ATTEMPTS=30
SPAMC_TIMEOUT_MS=10000
SPAMC_FAIL_OPEN=false
SA_BLOCK_THRESHOLD=12
SA_QUESTIONABLE_THRESHOLD=5
SPAM_SCL_SCORE=9
SPAM_SUBJECT_TAG=[SPAM]

# Plugin configuration is stored in MAILBRIDGE_PLUGIN_CONFIG_FILE.
# Secrets use MAILBRIDGE_PLUGIN_<PLUGIN_ID>_<SECRET_NAME> variables.
# Modern mode: 4 active processes, 100 waiting requests, 15-second wait limit,
# and 128 MiB V8 old-space limit per child. Legacy leaves concurrency/heap unlimited.
# The execution timeout remains 15 seconds in both profiles.
# MAILBRIDGE_PLUGIN_MAX_CONCURRENT=4
# MAILBRIDGE_PLUGIN_MAX_PENDING=100
# MAILBRIDGE_PLUGIN_WAIT_TIMEOUT_MS=15000
# MAILBRIDGE_PLUGIN_TIMEOUT_MS=15000
# MAILBRIDGE_PLUGIN_MEMORY_MB=128
# Process mode runs trusted plugins with the Mailbridge OS account's permissions.
# Optional Docker isolation requires a local engine and a pre-pulled pinned image.
# MAILBRIDGE_PLUGIN_SANDBOX=docker
# MAILBRIDGE_PLUGIN_DOCKER_NETWORK=none
# MAILBRIDGE_PLUGIN_DOCKER_IMAGE=node:22.23.3-trixie-slim@sha256:154ba2f4d6fec323d28e4f4bb86bba4677f1223391a1979cf521304e03a98dfa
